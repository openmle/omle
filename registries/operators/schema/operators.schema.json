{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "operators.schema.json",
  "title": "OMLE Operators Registry Schema",
  "$comment": "This schema validates JSON structure and local field constraints for the merged operators registry. Cross-reference integrity such as rule-name resolution, default-value type compatibility, uniqueness constraints beyond local object shape, and consistency with protobuf/body contracts are enforced by registry integrity checks and semantic validation.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "registry_type",
    "registry_version",
    "description",
    "namespaces"
  ],
  "properties": {
    "registry_type": {
      "const": "operators"
    },
    "registry_version": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string",
      "minLength": 1
    },
    "rule_language_version": {
      "type": "string",
      "minLength": 1
    },
    "input_kinds": {
      "type": "object",
      "additionalProperties": {
        "type": "string",
        "minLength": 1
      }
    },
    "type_rules": {
      "type": "object",
      "additionalProperties": {
        "type": "string",
        "minLength": 1
      }
    },
    "shape_rules": {
      "type": "object",
      "additionalProperties": {
        "type": "string",
        "minLength": 1
      }
    },
    "measure_level_rules": {
      "type": "object",
      "additionalProperties": {
        "type": "string",
        "minLength": 1
      }
    },
    "domain_rules": {
      "type": "object",
      "additionalProperties": {
        "type": "string",
        "minLength": 1
      }
    },
    "role_rules": {
      "type": "object",
      "additionalProperties": {
        "type": "string",
        "minLength": 1
      }
    },
    "namespaces": {
      "type": "array",
      "minItems": 0,
      "items": {
        "$ref": "#/$defs/namespace"
      }
    }
  },
  "$defs": {
    "input": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "required", "kinds"],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "required": {
          "type": "boolean"
        },
        "variadic": {
          "type": "boolean",
          "default": false
        },
        "kinds": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "enum": [
              "tensor",
              "column",
              "matrix",
              "numeric_tensor",
              "floating_tensor",
              "integer_tensor",
              "boolean_tensor",
              "string_tensor",
              "sparse_tensor",
              "token_sequence",
              "label_set_sequence"
            ]
          }
        },
        "shape_constraints": {
          "type": "array",
          "default": [],
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "measure_level_constraints": {
          "type": "array",
          "default": [],
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "output": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "type_rule",
        "shape_rule",
        "measure_level_rule"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "variadic": {
          "type": "boolean",
          "default": false
        },
        "type_rule": {
          "type": "string",
          "minLength": 1
        },
        "shape_rule": {
          "type": "string",
          "minLength": 1
        },
        "measure_level_rule": {
          "type": "string",
          "minLength": 1
        },
        "domain_rule": {
          "type": "string",
          "minLength": 1
        },
        "role_rule": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "attribute": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "type", "required"],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "type": {
          "type": "string",
          "enum": [
            "int",
            "float",
            "string",
            "bool",
            "scalar",
            "ints",
            "floats",
            "strings",
            "bools",
            "tensor_ref",
            "tensor",
            "sparse_tensor",
            "tensor_like",
            "tensor_type",
            "expression",
            "predicate"
          ]
        },
        "required": {
          "type": "boolean"
        },
        "default": {},
        "enum_values": {
          "type": "array",
          "items": {
            "type": ["string", "number", "integer", "boolean"]
          }
        },
        "description": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "operator": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "since",
        "category",
        "kind",
        "summary",
        "inputs",
        "outputs",
        "attributes",
        "validation_rules",
        "converter_notes"
      ],
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
        },
        "since": {
          "type": "string",
          "minLength": 1
        },
        "category": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "type": "string",
          "enum": ["generic", "structured"]
        },
        "body_type": {
          "type": "string",
          "minLength": 1
        },
        "summary": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "doc": {
          "type": "string",
          "minLength": 1
        },
        "inputs": {
          "type": "array",
          "minItems": 0,
          "items": {
            "$ref": "#/$defs/input"
          }
        },
        "outputs": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/output"
          }
        },
        "attributes": {
          "type": "array",
          "default": [],
          "items": {
            "$ref": "#/$defs/attribute"
          }
        },
        "validation_rules": {
          "type": "array",
          "default": [],
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "converter_notes": {
          "type": "array",
          "default": [],
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": { "const": "structured" }
            },
            "required": ["kind"]
          },
          "then": {
            "required": ["body_type"]
          }
        },
        {
          "if": {
            "properties": {
              "kind": { "const": "generic" }
            },
            "required": ["kind"]
          },
          "then": {
            "not": {
              "required": ["body_type"]
            }
          }
        }
      ]
    },
    "namespace": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version", "description", "operators"],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "operators": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/operator"
          }
        }
      }
    }
  }
}

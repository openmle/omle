{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "functions.schema.json",
  "title": "OMLE Functions Registry Schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "registry_type",
    "registry_version",
    "description",
    "parameter_conventions",
    "input_kinds",
    "type_rules",
    "measure_level_rules",
    "null_rules",
    "namespaces"
  ],
  "properties": {
    "registry_type": {
      "const": "functions"
    },
    "registry_version": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string"
    },
    "parameter_conventions": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "arguments",
        "optional_parameters",
        "variadic"
      ],
      "properties": {
        "arguments": {
          "type": "string",
          "minLength": 1
        },
        "optional_parameters": {
          "type": "string",
          "minLength": 1
        },
        "variadic": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "input_kinds": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "type_rules": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "measure_level_rules": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "null_rules": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "namespaces": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/namespace"
      }
    }
  },
  "$defs": {
    "parameter_base": {
      "type": "object",
      "required": [
        "name",
        "kinds"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "kinds": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        }
      }
    },
    "argument": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "kinds"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "kinds": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "variadic": {
          "type": "boolean"
        }
      }
    },
    "optional_parameter": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "kinds"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "kinds": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        }
      }
    },
    "returns": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type_rule",
        "measure_level_rule"
      ],
      "properties": {
        "type_rule": {
          "type": "string",
          "minLength": 1
        },
        "measure_level_rule": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "function": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "since",
        "category",
        "summary",
        "description",
        "arguments",
        "returns",
        "null_rule"
      ],
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
        },
        "since": {
          "type": "string",
          "minLength": 1
        },
        "category": {
          "type": "string",
          "minLength": 1
        },
        "summary": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string"
        },
        "arguments": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/argument"
          }
        },
        "optional_parameters": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/optional_parameter"
          }
        },
        "returns": {
          "$ref": "#/$defs/returns"
        },
        "null_rule": {
          "type": "string",
          "minLength": 1
        },
        "notes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "examples": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "namespace": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "version",
        "description",
        "functions"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string"
        },
        "functions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/function"
          }
        }
      }
    }
  }
}
